table test
	lineageTag: 37a49ceb-bc4f-4235-8f68-945a3ebeed55

	measure Revenue = SUM(SalesDetails[SalesAmount])
		lineageTag: 92495c90-3232-4017-add0-f9a0473e7bf1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cost = SUMX(SalesDetails,SalesDetails[UnitCost]*SalesDetails[OrderQuantity])
		lineageTag: 391a6aa4-5bb5-4acc-a8ce-4e04d7d790e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Profit = [Revenue]-[Cost]
		lineageTag: 76bb04e1-1846-4e39-b8eb-78dd0fdd35df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

